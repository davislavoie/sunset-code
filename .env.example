# Copy this file to .env and fill in the address other devices on your
# network can actually reach this machine at (Tailscale IP, LAN IP,
# hostname, etc). This is what gets baked into every image URL pushed to
# InfluxDB, and it must be reachable from the browsers/devices viewing the
# dashboard -- not just from inside Docker.
IMAGE_BASE_URL=http://100.107.153.41:8080
